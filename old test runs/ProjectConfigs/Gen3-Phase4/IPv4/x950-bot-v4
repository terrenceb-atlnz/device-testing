!
service password-encryption
!
hostname x950-bot
!
no banner motd
!
ssh server allow-users manager
service ssh
!
platform macsec enable
!
no service telnet
!
service http
!
clock timezone akl minus 6:00
!
snmp-server
!
!
!
aaa authentication enable default local
aaa authentication login default local
!
!
!
no service pim
service pdm
no service pim6
!
!
!
ip domain-lookup
!
!
!
no service dhcp-server
!
ip multicast-routing
!
ipv6 multicast-routing
!
spanning-tree mode rstp
!
lacp global-passive-mode enable
no spanning-tree rstp enable
!
switch 1 provision x950-52
!
vlan database
 vlan 10,20,30 state enable
!
interface port1.0.1-1.0.47
 switchport
 switchport mode access
 shutdown
!
interface port1.0.48
 description IXIA Multicast Sources
 switchport
 switchport mode access
 switchport access vlan 10
!
interface port1.0.49-1.0.53
 switchport
 switchport mode access
!
interface port1.0.57-1.0.61
 description Gen3
 switchport
 switchport mode access
 switchport access vlan 30
 channel-group 2 mode passive
!
interface eth0
 description Management
 ip address 10.38.140.26/27
 shutdown
!
interface po2
 description Gen3
 switchport
 switchport mode access
 switchport access vlan 30
!
interface vlan10
 description IXIA Multicast Source
 ip address 1.1.1.2/24
 ip igmp
!
interface vlan20
 description MACSEC
 ip address 2.2.2.2/24
!
interface vlan30
 description PIM-DM
 ip address 3.3.3.2/24
 ip pim dense-mode
!
ipv6 forwarding
!
line con 0
 exec-timeout 0 0
line vty 0 7
!
end