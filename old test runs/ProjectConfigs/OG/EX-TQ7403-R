!
service password-encryption
!
hostname EX_TQ7403-R
!
no banner motd
!
username nakabati privilege 15 password takuma
no username manager
!
ip vrf VRF-PINK 2
!
log buffered level informational facility local5
log host 192.168.10.123
log host 192.168.10.123 level debugging
!
ssh server allow-users manager
service ssh
!
no service telnet
!
service http
!
clock timezone JST plus 9:00
!
snmp-server
snmp-server enable trap atmf atmflink atmfnode
snmp-server community public rw
snmp-server host 192.168.10.123 public
snmp-server host 192.168.10.123 informs version 2c public
!
!
!
aaa authentication enable default local
aaa authentication login default local
!
!
atmf network-name Ring_Auth
atmf group EX,ex
!
zone public
 network wan
  ip subnet 0.0.0.0/0 interface ppp0
  host ppp0
   ip address dynamic interface ppp0
!
zone private
 network lan1
  ip subnet 10.1.1.0/24
  ip subnet 10.2.2.0/24
  ip subnet 10.22.22.0/24
  ip subnet 192.168.2.0/24
  ip subnet 192.168.10.0/24
  ip subnet 192.168.11.0/24
  ip subnet 192.168.20.0/24
  ip subnet 192.168.30.0/24
  ip subnet 192.168.40.0/24
  ip subnet 192.168.60.0/24
  ip subnet 192.168.90.0/24
  ip subnet 192.168.100.0/24
 network dhcp
  ip subnet 0.0.0.0/0 interface br1
  ip subnet 0.0.0.0/0 interface br2
!
application dhcp
 protocol udp
 dport 67 to 68
!
firewall
 rule 10 permit dhcp from private.dhcp to private.dhcp
 rule 20 permit any from private.lan1 to private.lan1
 protect
!
nat
 enable
!
!
!
!
!
ip domain-lookup
!
ip dhcp pool Ring_l2tpv3
 network 10.1.1.0 255.255.255.0
 range 10.1.1.100 10.1.1.110
 dns-server 10.1.1.1
 default-router 10.1.1.1
 lease infinite
!
ip dhcp pool Ring_gre
 network 10.2.2.0 255.255.255.0
 range 10.2.2.100 10.2.2.110
 dns-server 10.2.2.1
 default-router 10.2.2.1
 lease infinite
!
!
!
service dhcp-server
!
bridge 1
bridge 2
!
interface eth1
 description AR4050S-5G
 encapsulation dot1q 10
 encapsulation dot1q 11
 atmf-link
!
interface eth1.11
 ip vrf forwarding VRF-PINK
 ip address 192.168.11.253/24
!
interface eth1.10
 ip address 192.168.10.253/24
!
interface eth2
 encapsulation ppp 0
 bridge-group 1
!
interface tunnel0
 description connect_to_AR3050S
 bridge-group 1
 mtu 1500
 tunnel source 192.168.10.253
 tunnel destination 192.168.60.8
 tunnel df clear
 tunnel local id 101
 tunnel remote id 102
 tunnel mode l2tp v3
!
interface tunnel1
 description to_AR3050S
 tunnel source 192.168.10.253
 tunnel destination 192.168.60.8
 tunnel mode gre
 ip address 10.22.22.1/24
!
interface br1
 description to_tb5000/l2tpv3_vap1.0
 ip address 10.1.1.114/24
!
interface br2
 description gre_vap2.0
 ip address 10.2.2.1/24
!
interface vap1.0
 bridge-group 1
!
interface vap2.0
 bridge-group 2
!
service statistics interfaces
!
ip route 0.0.0.0/0 eth1.11
ip route 192.168.60.0/24 192.168.10.2
ip route 192.168.100.0/24 tunnel1
ip route vrf VRF-PINK 192.168.2.0/24 192.168.11.1
!
wireless
 security 1 mode wpa-personal
  key 12345678
  versions wpa2 wpa3
 security 17 mode wpa-personal
  key 12345678
  versions wpa2 wpa3
 security 33 mode enhanced-open
 network 1
  ssid allied24_l2tpv3
  security 1
 network 17
  ssid allied5-1_gre
  security 17
 network 33
  ssid allied5-2
  security 33
 network 111
  passpoint
   dot11u
    domain-name example.com
 ap-profile local
  management remote-sessions 1
  radio 1
   enable
   vap 0 network 1
  radio 2
   enable
   vap 0 network 17
  radio 3
   vap 0 network 33
 ap local
!
line con 0
 exec-timeout 0 0
 length 0
line vty 0 7
!
end
