!
service password-encryption
!
hostname 07_SE240
!
no banner motd
!
username nakabati privilege 15 password takuma
no username manager
!
log buffered level informational facility local5
log host 192.168.10.123
log host 192.168.10.123 level debugging
!
no service ssh
!
autoboot enable
!
service telnet
!
service http
!
clock timezone JST plus 9:00
!
snmp-server
snmp-server enable trap atmf atmflink atmfnode
snmp-server community public rw
snmp-server host 192.168.10.123 public
snmp-server host 192.168.10.123 informs version 2c public
!
!
radius-server host 192.168.10.2 key kkk
aaa group server radius dot1x
 server 192.168.10.2
aaa group server radius mac
 server 192.168.10.2
aaa group server radius web
 server 192.168.10.2
!
!
aaa authentication enable default local
aaa authentication login default local
aaa authentication dot1x default group dot1x
aaa authentication auth-mac default group mac
aaa authentication auth-web default group web
aaa accounting dot1x default start-stop group dot1x
aaa accounting auth-mac default start-stop group mac
aaa accounting auth-web default start-stop group web
!
!
atmf network-name Ring_Auth
atmf group 07,GUI,Marvell
!
service atmf-application-proxy
!
!
!
ip name-server 8.8.8.8
ip domain-lookup
!
!
spanning-tree mode rstp
!
service power-inline
auth-web-server ipaddress 10.10.10.2
auth-web-server page language japanese
lacp global-passive-mode enable
no spanning-tree rstp enable
!
vlan database
 vlan 10,60,3386 state enable
!
access-list 3000 send-to-cpu ip any 10.10.10.2/32
access-list 3001 deny ip 192.168.60.55/32 192.168.20.2/32
access-list 3002 deny ip 192.168.60.55/32 192.168.40.33/32
!
interface port1.0.1
 description HUB_v3
 switchport
 switchport mode access ingress-filter disable
 switchport access vlan 60
 thrash-limiting action none
 access-group 3000
 access-group 3002
 snmp trap link-status
 auth-mac enable
 auth-web enable
 dot1x port-control auto
 auth host-mode multi-supplicant
 auth forward arp
 auth forward dhcp
 auth forward dns
!
interface port1.0.2
 description x230
 switchport
 switchport mode trunk
 switchport trunk allowed vlan add 10,60
 snmp trap link-status
 switchport atmf-link
!
interface port1.0.3
 description TQ5403-ID1
 switchport
 switchport mode access
 switchport access vlan 10
 shutdown
!
interface port1.0.4
 description TQm5403-ID2
 switchport
 switchport mode access
 switchport access vlan 10
 shutdown
!
interface port1.0.5
 description TQm6602G2-ID3
 switchport
 switchport mode access
 switchport access vlan 10
!
interface port1.0.6
 description TQ6602-ID1
 switchport
 switchport mode trunk
 switchport trunk allowed vlan add 3386
 switchport trunk native vlan 10
 thrash-limiting action none
 power-inline pair data max 15400
 power-inline pair spare max 15400
!
interface port1.0.7
 description TQ6602-ID2
 switchport
 switchport mode trunk
 switchport trunk allowed vlan add 3386
 switchport trunk native vlan 10
 thrash-limiting action none
 power-inline pair data max 15400
 power-inline pair spare max 15400
!
interface port1.0.8
 description TQ6602-ID3
 switchport
 switchport mode trunk
 switchport trunk allowed vlan add 3386
 switchport trunk native vlan 10
 thrash-limiting action none
 power-inline pair data max 15400
 power-inline pair spare max 15400
!
interface port1.0.9
 switchport
 switchport mode access
!
interface port1.0.10
 switchport
 switchport mode access
!
interface vlan10
 ip address 192.168.10.7/24
!
interface vlan60
 ip address 192.168.60.7/24
!
ip radius source-interface 192.168.60.7
!
ip route 0.0.0.0/0 192.168.10.4
!
line con 0
 exec-timeout 0 0
 length 0
line vty 0 7
!
end
