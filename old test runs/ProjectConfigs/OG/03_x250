!
service password-encryption
!
hostname 03_x250
!
no banner motd
!
username nakabati privilege 15 password takuma
no username manager
!
log buffered level informational facility local5
log host 192.168.10.123
log host 192.168.10.123 level debugging
!
no service ssh
!
service telnet
!
service http
!
clock timezone JST plus 9:00
!
snmp-server
snmp-server enable trap atmf atmflink atmfnode
snmp-server community public rw
snmp-server host 192.168.10.123 public
snmp-server host 192.168.10.123 informs version 2c public
!
!
radius-server host 192.168.20.2 key aaa
aaa group server radius dot1x
 server 192.168.20.2
aaa group server radius mac
 server 192.168.20.2
aaa group server radius web
 server 192.168.20.2
!
!
aaa authentication enable default local
aaa authentication login default local
aaa authentication dot1x default group dot1x
aaa authentication auth-mac default group mac
aaa authentication auth-web default group web
aaa accounting dot1x default start-stop group dot1x
aaa accounting auth-mac default start-stop group mac
aaa accounting auth-web default start-stop group web
!
!
!
stack virtual-mac
stack management subnet 172.21.255.128
stack virtual-chassis-id 18
stack resiliencylink vlan4001
stack 1 priority 64
!
atmf network-name Ring_Auth
atmf group 03,GUI,Marvell
!
service atmf-application-proxy
!
!
!
ip domain-lookup
!
no service dhcp-server
!
spanning-tree mode rstp
!
auth-web-server ipaddress 10.10.10.1
auth-web-server page language japanese
lacp global-passive-mode enable
no spanning-tree rstp enable
!
switch 1 provision x250-28
!
vlan database
 vlan 40 state enable
!
access-list 3000 send-to-cpu ip any 10.10.10.1/32
access-list 3003 deny ip 192.168.40.33/32 192.168.60.7/32
!
interface port1.0.1-1.0.2
 switchport
 switchport mode access
 shutdown
!
interface port1.0.3
 description x930
 switchport
 switchport mode trunk
 switchport trunk allowed vlan add 40
 switchport trunk native vlan none
 thrash-limiting action none
 static-channel-group 2
!
interface port1.0.4
 description x930
 switchport
 switchport mode trunk
 switchport trunk allowed vlan add 40
 switchport trunk native vlan none
 thrash-limiting action none
 static-channel-group 2
!
interface port1.0.5
 description IXIA-5_v40
 switchport
 switchport mode access
 switchport access vlan 40
!
interface port1.0.6
 switchport
 switchport mode access
!
interface port1.0.7
 description HUB_v3
 switchport
 switchport mode access ingress-filter disable
 switchport access vlan 40
 thrash-limiting action none
 access-group 3000
 snmp trap link-status
 auth-mac enable
 auth-web enable
 dot1x port-control auto
 auth host-mode multi-supplicant
 auth forward arp
 auth forward dhcp
 auth forward dns
!
interface port1.0.8-1.0.26
 switchport
 switchport mode access
!
interface port1.0.27-1.0.28
 stackport
!
interface sa2
 description x930
 switchport
 switchport mode trunk
 switchport trunk allowed vlan add 40
 switchport trunk native vlan none
 switchport atmf-link
!
interface vlan40
 ip address 192.168.40.3/24
!
ip radius source-interface 192.168.40.3
!
ip route 192.168.0.0/16 192.168.40.2
!
line con 0
 exec-timeout 0 0
 length 0
line vty 0 7
!
