!
service password-encryption
!
hostname 08_AR3050S
!
no banner motd
!
username nakabati privilege 15 password takuma
no username manager
!
log buffered level informational facility local5
log host 192.168.10.123
log host 192.168.10.123 level debugging
!
service ssh
!
service telnet
!
service http
!
clock timezone JST plus 9:00
!
snmp-server
snmp-server enable trap atmf atmflink atmfnode
snmp-server community public rw
snmp-server host 192.168.10.123 public
snmp-server host 192.168.10.123 informs version 2c public
!
!
!
aaa authentication enable default local
aaa authentication login default local
!
!
atmf network-name Ring_Auth
atmf group 08,Broadcom,GUI
!
crypto isakmp key ouR4ecret address 10.2.2.2
!
!
!
no service url-offload
!
service atmf-application-proxy
!
no service pim
!
!
!
ip domain-lookup
!
!
!
service dhcp-server
!
ip multicast-routing
!
bridge 1
spanning-tree mode rstp
!
lacp global-passive-mode enable
no spanning-tree rstp enable
!
vlan database
 vlan 60,90,100 state enable
!
interface port1.0.1
 description x230
 switchport
 switchport mode trunk
 switchport trunk allowed vlan add 60
 switchport trunk native vlan none
 snmp trap link-status
 switchport atmf-link
!
interface port1.0.2-1.0.3
 switchport
 switchport mode access
!
interface port1.0.4
 description IXIA-4_v60
 switchport
 switchport mode trunk
 switchport trunk allowed vlan add 60,90
 switchport trunk native vlan none
!
interface port1.0.5-1.0.8
 switchport
 switchport mode access
 shutdown
!
interface vlan1
 bridge-group 1
!
interface vlan60
 ip address 192.168.60.8/24
!
interface vlan90
 bridge-group 1
!
interface vlan100
 description TQ7403-R_gre
 ip address 192.168.100.8/24
!
interface tunnel0
 description connect_to_TQ7403-R
 bridge-group 1
 mtu 1500
 tunnel source vlan60
 tunnel destination 192.168.10.253
 tunnel df clear
 tunnel local id 102
 tunnel remote id 101
 tunnel mode l2tp v3
!
interface tunnel1
 description connect_to_TQ7403-R
 tunnel source vlan60
 tunnel destination 192.168.10.253
 tunnel mode gre
 ip address 10.22.22.2/24
!
interface br1
 ip address 10.1.1.2/24
!
service statistics interfaces
!
ip route 0.0.0.0/0 192.168.60.4
ip route 10.2.2.0/24 tunnel1
!
line con 0
 exec-timeout 0 0
 length 0
line vty 0 7
!
end
