service ssh
!
no service telnet
!
service http
!
clock timezone NZST plus 12:00
clock summer-time NZDT recurring 5 Sun Sep 02:00 1 Sun Apr 02:00 60
!
snmp-server
!
![K
!
aaa authentication enable default local
aaa authentication login default local
!
!
!
!
no service url-offload
!
ntp server 10.38.215.65
!
!
!
!
ip domain-lookup
!
!
!
no service dhcp-server
!
no ip multicast-routing
!
lldp run
!
spanning-tree mode rstp
!
no lacp global-passive-mode enable
no spanning-tree rstp enable
!
router-id 10.10.10.2
!
vlan database
 vlan 10 name transit
 vlan 22 name flap-deadend
 vlan 10,22 state enable
!
interface port1.0.1
 switchport
 switchport mode access
!
interface port1.0.2
 switchport
 switchport mode access
 switchport access vlan 10
 shutdown
![K
interface port1.0.3-1.0.4
 switchport
 switchport mode access
 switchport access vlan 10
 static-channel-group 1
!
interface port1.0.5-1.0.8
 switchport
 switchport mode access
!
interface lo
 ipv6 address 2001:db8:427::1/64
 ipv6 enable
!
interface sa1
 switchport
 switchport mode access
 switchport access vlan 10
!
interface vlan1
 ip address 10.38.215.70/27
 ipv6 enable
 ipv6 address dhcp
 ip dhcp-client vendor-identifying-class
 ip dhcp-client request vendor-identifying-specific
!
interface vlan10
 ip address 10.10.10.2/27
!
ip route 10.38.215.0/27 10.10.10.1
ip route 10.38.215.32/27 10.10.10.1
!
line con 0
 exec-timeout 0 0
line vty 0 7
!
end

