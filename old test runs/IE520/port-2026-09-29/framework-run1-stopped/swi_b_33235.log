 stackport
!
interface sa3
 switchport
 switchport mode access
!
interface vlan1
 ip address 10.38.215.41/27
 ipv6 enable
 ipv6 address dhcp
 ip dhcp-client vendor-identifying-class
 ip dhcp-client request vendor-identifying-specific
!
line con 0
 exec-timeout 0 0
line vty 0 7
!
end

