7[r[999;999H[6n!
hostname IE520
!
no banner motd
!
username manager privilege 15 password 8 $5$dV7d.jnV$2W9Fnx0l.c5pEALvd0ywf8.dKluBk/gzc9886yI.812
!
!
no service ssh
!
no service telnet
!
service http
!
no clock timezone
!
snmp-server
!
!
!
aaa authentication enable default local
aaa authentication login default local
!
security-password minimum-length 8
security-password history 1
!
!
!
stack virtual-mac
stack virtual-chassis-id 3439
stack 1 priority 1
!
!
no service ospf
!
!
!
!
ip domain-lookup
!
!
!
no service dhcp-server
!
!
!
no ip multicast-routing
!
lldp run
!
spanning-tree mode rstp
!
no lacp global-passive-mode enable
no spanning-tree rstp enable
!
switch 1 provision ie520-28
switch 2 provision ie520-28
switch 3 provision ie520-28
switch 4 provision ie520-28
!
vlan database
 vlan 2-3 state enable
!
interface port1.0.1-1.0.26
 switchport
 switchport mode access
!
interface port1.0.27-1.0.28
 stackport
!
interface port2.0.1-2.0.26
 switchport
 switchport mode access
!
interface port2.0.27-2.0.28
 stackport
!
interface port3.0.1-3.0.24
 switchport
 switchport mode access
!
interface port3.0.25
 switchport
 switchport mode access
 switchport access vlan 3
!
interface port3.0.26
 switchport
 switchport mode access
!
interface port3.0.27-3.0.28
 stackport
!
interface port4.0.1-4.0.24
 switchport
 switchport mode access
!
interface port4.0.25
 switchport
 switchport mode access
 switchport access vlan 2
!
interface port4.0.26
 switchport
 switchport mode access
!
interface port4.0.27-4.0.28
 stackport
!
interface vlan1
 ip address 10.37.101.10/27
 ip address 10.37.101.40/27 secondary
 ip address 10.37.101.70/27 secondary
!
interface vlan2
 ip address 2.2.2.2/24
!
interface vlan3
 ip address 3.3.3.3/24
!
line con 0
 exec-timeout 0 0
line vty 0 7
!
end
