### RUN .setup for group D (ntp-2026-10-21T1159), cut from the GENERATED fence of
### bench-setup/tb277/bench-state.md (capture 2026-10-20T230259Z) on 2026-10-21.
### Declares ONLY swi_d (u2, the DUT), per STANDING-ORDERS §6.
###
### Group D's dispatch gives `consoles: u2 ONLY`: swi_b (u3) and swi_a (u5) both have a LOCKED
### `manager` account and must not be opened, probed or logged into by anything. They are
### therefore absent from this file entirely -- no [switch], no [baudrates], no [power],
### no [powerlink], no [boot_from_flash] and no [portlink] touching them. With no entry at all
### the framework's post-failure power cycle can never reach either unit.
###
### The NTP partner for all three cases is the TESTBOX ITSELF (eth3 10.38.22.33/27 on swi_d's
### vlan10, eth4 10.38.22.65/27 on swi_d's vlan48), not a partner switch.
### The box has NO deployed /home/st-art/configs/tb277.setup; never bind one.

[power]
pwr_d = (pdu, 10.36.230.212, 1)

[switch]
swi_d = /dev/u2

[baudrates]
swi_d = 115200

[stack]

[configured_stackport]

[powerlink]
swi_d = pwr_d

[boot_from_flash]
swi_d = True

[portlink]
tb-swi_d = eth3-port1.0.10, eth4-port1.0.48
