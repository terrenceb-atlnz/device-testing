    -> Access-Request id=139 to 10.38.22.34:1812 from 10.38.22.33  User-Name='radclient1@example.com', User-Password=<hidden,16 bytes>, NAS-IP-Address=10.38.22.33, NAS-Port=0, NAS-Port-Type=5, Service-Type=1(Login)
    <- NO REPLY after 4.0s (x2)  [ICMP port unreachable: nothing listening on that UDP port]
    radsend: sent=1 replies=0 no_reply=1 rejects=0 bad_authenticator=0
    rc=1

  Stage 2: remove the whole block.

awplus# configure terminal
awplus(config)# no radius-server proxy-server
awplus(config)# end

awplus# show radius proxy-server
                                           <-- no output at all
awplus# show running-config | include radius|aaa
    aaa authentication enable default local
    aaa authentication login default local
