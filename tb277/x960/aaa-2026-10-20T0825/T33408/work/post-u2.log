!
!
!
no service dhcp-server
!
no ip multicast-routing
!
lldp run
!
spanning-tree mode rstp
!
lacp global-passive-mode enable
!
switch 1 provision x960-56
!
vlan database
 vlan 10 name ckUNDERLAY-eth3
 vlan 48 name ckUNDERLAY-eth4
 vlan 10,48 state enable
!
interface port1.0.1-1.0.9
 switchport
 switchport mode access
!
interface port1.0.10
 switchport
 switchport mode access
 switchport access vlan 10
!
interface port1.0.11-1.0.47
 switchport
 switchport mode access
!
interface port1.0.48
 switchport
 switchport mode access
 switchport access vlan 48
!
interface port1.0.49-1.0.77
 switchport
 switchport mode access
!
interface eth0
 ip address dhcp
 ipv6 enable
 ipv6 address dhcp
!
interface vlan1
 ip address dhcp
 ipv6 enable
 ipv6 address dhcp
 ip dhcp-client vendor-identifying-class
 ip dhcp-client request vendor-identifying-specific
!
interface vlan10
 ip address 10.38.22.34/27
!
interface vlan48
 ip address 10.38.22.66/27
!
line con 0
line vty 0 7
!
end
