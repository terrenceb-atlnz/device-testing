### RUN .setup for group B (mgmt-2026-10-21T1159), cut from the GENERATED fence of
### bench-setup/tb277/bench-state.md (capture 2026-10-20T230259Z) on 2026-10-21.
### Declares ONLY the units this group uses: swi_d (u2, DUT) and swi_b (u3, partner).
### swi_a (u5) is deliberately ABSENT -- the session constraint forbids rebooting or
### power-cycling it, and the framework's post-failure power cycle reaches every unit a
### bound .setup lists (STANDING-ORDERS §6). Never bind the deployed box .setup here.

[power]
pwr_b = (pdu, 10.36.230.212, 7)
pwr_d = (pdu, 10.36.230.212, 1)

[switch]
swi_b = /dev/u3
swi_d = /dev/u2

[baudrates]
swi_b = 9600
swi_d = 115200

[stack]

[configured_stackport]

[powerlink]
swi_b = pwr_b
swi_d = pwr_d

[boot_from_flash]
swi_b = True
swi_d = True

[portlink]
tb-swi_d = eth3-port1.0.10, eth4-port1.0.48
swi_b-swi_d = port1.0.16-port1.0.16, port1.0.2-port1.0.2
