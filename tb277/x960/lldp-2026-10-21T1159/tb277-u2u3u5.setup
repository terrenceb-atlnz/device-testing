### RUN .setup for group C (lldp-2026-10-21T1159), cut from the GENERATED fence of
### bench-setup/tb277/bench-state.md (capture 2026-10-20T230259Z) on 2026-10-21.
### Declares the three units this group uses: swi_d (u2, DUT), swi_b (u3) and swi_a (u5),
### both partners being live LLDP neighbours the cases measure against.
###
### swi_a (u5) is present BUT HAS NO [powerlink] ENTRY and no [power] outlet, deliberately:
### the session constraint forbids rebooting or power-cycling it, and the framework's
### post-failure power cycle reaches every unit that has a powerlink (STANDING-ORDERS §6).
### With no powerlink the cycle returns a silent False for swi_a and the unit is never touched.
### Never bind the deployed box .setup here.

[power]
pwr_b = (pdu, 10.36.230.212, 7)
pwr_d = (pdu, 10.36.230.212, 1)

[switch]
swi_a = /dev/u5
swi_b = /dev/u3
swi_d = /dev/u2

[baudrates]
swi_a = 9600
swi_b = 9600
swi_d = 115200

[stack]

[configured_stackport]

[powerlink]
swi_b = pwr_b
swi_d = pwr_d

[boot_from_flash]
swi_a = False
swi_b = True
swi_d = True

[portlink]
tb-swi_d = eth3-port1.0.10, eth4-port1.0.48
swi_a-swi_b = port1.0.1-port1.0.1, port1.0.11-port1.0.11
swi_a-swi_d = port1.0.14-port1.0.14, port1.0.4-port1.0.4
swi_b-swi_d = port1.0.16-port1.0.16, port1.0.2-port1.0.2
