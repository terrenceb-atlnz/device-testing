  cap L0b-off-eth4.pcap: 6 frame(s)
    x3     ARP-REQ  who-has 192.168.48.9    tell 192.168.48.1      [eth e0:1a:ea:d4:70:43 -> ff:ff:ff:ff:ff:ff]
    x3     ARP-REQ  who-has 192.168.48.10   tell 192.168.48.1      [eth e0:1a:ea:d4:70:43 -> ff:ff:ff:ff:ff:ff]
