# T9032 run 2, 2026-10-28 -- hands ONE process an OpenSSL ceiling of TLS 1.2.
# Used only via OPENSSL_CONF=<this file> on the wpa_supplicant child that tools/wpasup.py
# starts. /etc/ssl/openssl.cnf on tb277 is NOT touched and no other user of the box is
# affected. wpa_supplicant 2.6 predates RFC 9190 (EAP-TLS with TLS 1.3) while the OpenSSL
# 1.1.1 beneath it negotiates TLS 1.3 happily; this file removes that mismatch.
openssl_conf = ck_conf

[ck_conf]
ssl_conf = ck_ssl

[ck_ssl]
system_default = ck_ssl_default

[ck_ssl_default]
MinProtocol = TLSv1.2
MaxProtocol = TLSv1.2
CipherString = DEFAULT@SECLEVEL=1
