    #1   10:13:37.436 10.38.22.34:44805 -> 10.38.22.33:162  SNMPv2c  community='testing123' pdu=SNMPv2-Trap  msgData=PLAINTEXT
          1.3.6.1.2.1.1.3.0 = TimeTicks: 31266075
          1.3.6.1.6.3.1.1.4.1.0 = OID: 1.3.6.1.2.1.16.0.1   <- risingAlarm
