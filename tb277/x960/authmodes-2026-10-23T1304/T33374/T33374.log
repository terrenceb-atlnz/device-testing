STEP 4 -- removal: `no auth reauthentication` stops it                       PASS
--------------------------------------------------------------------------------
  Method: the period was deliberately left at 15 seconds.  So this step tests the
  enable command alone, not the clearing of the period.

awplus# configure terminal
awplus(config)# interface port1.0.48
awplus(config-if)# no auth reauthentication
awplus(config-if)# end

awplus# show running-config interface port1.0.48
!
interface port1.0.48
 switchport
 switchport mode access
 switchport access vlan 48
 dot1x port-control auto
 dot1x control-direction both
 auth timeout reauth-period 15        <-- the period is still configured
!
awplus# show auth interface port1.0.48 | include reAuth
  reAuthenticate: disabled
  reAuthPeriod: 15                    <-- still 15

