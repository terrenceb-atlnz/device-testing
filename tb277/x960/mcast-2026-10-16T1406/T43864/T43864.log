    --icmp 10.38.22.65 --gw-mac e0:1a:ea:d4:70:43 --sender-ip 10.38.22.40 \
    --sender-mac 00:11:22:33:44:01 --count 20 --gap 0.25 --settle 3 --wait 5 \
