### Cross-box link, not expressible here: swi_b port1.0.49 <-> tb490 DUT (x980-16CDQ) port1.0.81.
### Client path to the DUT: tb5 eth6 (00:90:0b:2a:11:c3, 192.168.50.10/24 + macvlans jm1-jm5)
###   -> swi_c port1.0.16 .. swi_c port1.0.1 -> swi_b port1.0.39 .. swi_b port1.0.49 -> DUT port1.0.81.
### swi_b and swi_c both carry `dot1x eap forward`.
### No PDU (session fact). Names are the probe's auto-names (swi_a here = AR4050S; tb490's DUT is
### also auto-named swi_a) -- names wait for the Test Engineer.
### swi_c boot_from_flash = False because its `show boot` reports Current boot image: Not set.

[power]

[switch]
swi_a = /dev/u2
swi_b = /dev/u0
swi_c = /dev/u1

[baudrates]
swi_a = 115200
swi_b = 115200
swi_c = 115200

[stack]

[configured_stackport]

[powerlink]

[boot_from_flash]
swi_a = True
swi_b = True
swi_c = False

[portlink]
tb-swi_a = eth4-port1.0.8
tb-swi_c = eth6-port1.0.16
swi_b-swi_c = port1.0.39-port1.0.1
