### TOPOLOGY PROFILES this bench implements -- the contract generated scripts target.
### Spec: ask-ck/pytest-create/TOPOLOGY-PROFILES.md ; checker: tool/pt_profiles.py
### Verify with:  python3 tool/pt_preflight.py --setup <this file> --profile all
###
### `ck_link_*` is <devA>-<devB>:<port on devA>. The `:port` suffix is what disambiguates
### WHICH of several links between the same pair is meant -- swi_a<->swi_b has both a
### copper and a fibre link, and MDI/MDIX is copper-only, so binding "a port-type link"
### is not good enough (the CLI even accepts `polarity` on fibre, where it does nothing).
### Keep these values COMMA-FREE: the framework turns a comma-bearing [misc] value into
### a list. `ck_profile` is deliberately a comma list.
###
### `ck_cap_*` records capabilities VERIFIED ON THE DEVICE, never inferred from the docs.
### `polarity` is documented for 29 products NOT including ie520 -- yet both IE520s here
### support it (confirmed at the console 2026-07-30 via `polarity ?` in interface config).
### Absence from the harvested CLI reference means UNKNOWN, not unsupported.
###
### NOT implemented: `stack` -- the two IE520s were deliberately de-stacked 2026-07-30.
[misc]
ck_profile     = base, fibre, tblink
ck_role_dut    = swi_a
ck_link_copper = swi_a-swi_b:port1.0.1
ck_link_fibre  = swi_a-swi_b:port1.0.7
ck_link_tb     = tb-swi_a:eth3
ck_cap_swi_a   = polarity
ck_cap_swi_b   = polarity

### PDU/sentry outlets. Format: pwr_X = (pdu, <IP>, <outlet>)  [sentry also valid].
### The outlet field is parsed with int() (Setup.py: int(outTuple[2]) for any non-awplus
### type), so it MUST be the numeric outlet -- the PDU front-panel LETTER is a label only.
### The mapping is A-H = 1-8: D = 4, E = 5, F = 6, H = 8. Names mirror the device they feed.
###
### CHANGED 2026-08-11: BOTH IE520s ARE NOW ON THE PDU (pwr_a = "D", pwr_b = "E"), so
### swi_a and swi_b CAN now be power-cycled. This reverses the 2026-07-30 position that
### neither was fitted and that any test step needing a power-cycle was un-runnable here
### -- which was the single thing blocking the 5700 bootloader suites on this bench.
[power]
pwr_a = (pdu, 10.36.150.14, 4)
pwr_b = (pdu, 10.36.150.14, 5)
pwr_c = (pdu, 10.36.150.14, 8)
pwr_d = (pdu, 10.36.150.14, 6)

[switch]
swi_a = /dev/u4
swi_b = /dev/u5
swi_c = /dev/u1
swi_d = /dev/u0

[baudrates]
swi_a = 115200
swi_b = 115200
swi_c = 115200
swi_d = 9600

