### tb470.static -- the bench facts no `show` command can reveal. Hand-entered, one time.
### bench_probe.py reads this when it generates bench-state.md / tb470.setup:
###   - a unit's swi_ name follows its SERIAL, so the name stays put when consoles or
###     stack IDs move (the .setup binds tests to swi_a, stk_a ... by name);
###   - its PDU outlet is the NUMERIC outlet (front-panel letters A-H = 1-8; Setup.py
###     parses the field with int()). "-" = unknown, so no [power]/[powerlink] is emitted
###     and a test that power-cycles the unit will hit the framework's silent-False path.
### When the probe meets a unit that is not listed here it asks (on a terminal) and
### appends the answer; without a terminal it names the unit for that run and says so.

[pdu]
ip = 10.36.150.14

### serial = name, outlet
[units]
264A23061 = swi_a, 6    ### IE520-28GSX, stack member 1 -- outlet F/6 (Terrence-confirmed 2026-09-15)
264A23068 = swi_b, 8    ### IE520-28GSX "IE520-sa", standalone since 2026-09-23 -- outlet H/8 (Terrence-confirmed 2026-09-28)
264A23066 = swi_c, 5    ### IE520-28GSX, stack member 3 -- outlet E/5
264A23052 = swi_d, 4    ### IE520-28GSX, stack member 4 -- outlet D/4
A10401G214000005 = swi_e, 7    ### AR4050S-5G "4050-5g" -- outlet G/7 (Terrence-confirmed 2026-09-28)
G26ZE80EN = swi_f, 1    ### x230-10GP -- outlet A/1 (Terrence-confirmed 2026-09-28)
