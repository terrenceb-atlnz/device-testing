### T33234 run setup (triage 2026-10-13 draft, used unchanged by RUN 2026-10-13) -- T33234 5000.0003/0004 on tb470 u0/u1
### swi_a = x230v2-28GS (DUT, u0, S/N A10783G262900002); swi_b = AR4050S-5G (link partner, u1)
[power]
pwr_a = (pdu, 10.36.150.14, 1)
pwr_b = (pdu, 10.36.150.14, 7)
[switch]
swi_a = /dev/u0
swi_b = /dev/u1
[baudrates]
swi_a = 115200
swi_b = 115200
[powerlink]
swi_a = pwr_a
swi_b = pwr_b
[boot_from_flash]
swi_a = True
swi_b = True
[portlink]
swi_a-swi_b = port1.0.1-port1.0.2, port1.0.8-port1.0.5
[misc]
dutSFPCopper    = port1.0.1
linkpSFPCopper  = port1.0.2
dutSFPCopperX   = port1.0.8
linkpSFPCopperX = port1.0.5
