# T22653 read port information. Port block: 13 words per port from 0x5000; @M.0.N = unit M.
# port1.0.1 is an empty SFP cage (zeros); port1.0.2 (x230 link) and port3.0.13 (tb470 eth1) are the live control.
step SETUP
cli configure terminal ;; scada modbus tcp server ;; end
cli show interface port1.0.1 =~ Link is DOWN, administrative state is UP
step 1 #1 Port Current State
read - @1.0.1 1 HEX 0000
read - @1.0.2 1 HEX f103 control: up full auto 1000
read - @3.0.13 1 HEX f103 control
step 2 #1 Port Configured State
read - @1.0.1+1 1 HEX f000
read - @1.0.2+1 1 HEX f000
step 3 PoE Configuration
read - @1.0.1+2 1 HEX exc
cli show power-inline =~ Invalid input
step 4 PoE Data Pairs Power
read - @1.0.1+3 1 UINT exc
step 5 PoE Spare Pairs Power
read - @1.0.1+4 1 UINT exc
step 6 Input Bytes
read - @1.0.1+5 4 UINT 0
read - @1.0.2+5 4 UINT ~ = CLI input bytes
cli show interface port1.0.2 =~ input packets \d+, bytes \d+
step 7 Output Bytes (0x5009; the case text says Input)
read - @1.0.1+9 4 UINT 0
read - @1.0.2+9 4 UINT ~ = CLI output bytes
cli show interface port1.0.2 =~ output packets \d+, bytes \d+
step TEARDOWN
cli configure terminal ;; no scada modbus tcp server ;; end
probe 502 refused
