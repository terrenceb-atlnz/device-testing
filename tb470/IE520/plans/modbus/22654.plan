# T22654 modbus write (IPv4). Steps 4-5 are 22654-ipv6.plan, run between setup-v6 and teardown-v6 below.
# The LED bit is the MSB (0x8000); the case's literal 0x0001 is acknowledged with no effect.
step SETUP
cli configure terminal ;; scada modbus tcp server ;; scada modbus tcp server access read-write ;; end
cli show scada modbus tcp server =~ Write access: enabled
step 1 Alarm Configuration write
read 1 0x3001 1 HEX 0000
write 1 0x3001 0x0001 ok case literal
read 1 0x3001 1 HEX 0000 literal not stored
write 1 0x3001 0x8000 ok LED
read 1 0x3001 1 HEX 8000
cli show alarm facility settings | include PSU =~ External PSU\s+1\s+L
cli show running-config | include alarm =~ alarm facility power-supply 1 input-member 1 led
log with data 0x8000
write 1 0x3001 0x0000 ok clear
read 1 0x3001 1 HEX 0000 cleared
step 2 Port Configured State write (port1.0.1)
write - @1.0.1+1 0x0000 ok
read - @1.0.1+1 1 HEX 0000
cli show interface port1.0.1 =~ administrative state is DOWN
log port1.0.1 user shutdown
write - @1.0.1+1 0xf000 ok
read - @1.0.1+1 1 HEX f000
cli show interface port1.0.1 =~ administrative state is UP
step 3 PoE Configuration write
write - @1.0.1+2 0xff00 exc
cli show power-inline =~ Invalid input
step setup-v6 (then run 22654-ipv6.plan twice)
cli configure terminal ;; interface vlan1 ;; ipv6 address fd32:b1f0:dff8:d701::10/64 ;; end
cli show ipv6 interface brief =~ fd32:b1f0:dff8:d701::10
