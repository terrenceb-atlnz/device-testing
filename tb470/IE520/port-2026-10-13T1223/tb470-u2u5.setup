### tb470 run .setup for CAMPAIGN-QUEUE-2026-10-13T1223 (T33235, Ask-CK validation 2026-10-13T1223-val-3ede),
### written at triage 2026-10-13 12:3x NZDT by bench-runner.
### = the 0954 draft (port-2026-10-13T0954/tb470-u2u5.setup) + the probe fence of capture
### bench-setup/captures/2026-10-12T232732Z (read-only probe, u2-u5): [power]..[boot_from_flash] identical to that fence,
### plus [portlink] swi_a-swi_b (links C and M, LLDP-proven both ends in that capture).
### No swi_e/swi_f, pwr_e/pwr_f or any link to them (session constraint: no 4050/x230; outlets 1 and 7 never cycled).
### tb-swi_c is carried from the deployed tb470.setup (Oct 13 12:21): its stack end port3.0.13 reads connected
### 1000BASE-T VLAN 1; eth1's MAC was not re-learned because the probe ran --read-only (NEEDS-CHECK, no host pings).
### The script binds no tb role; the link only keeps the testbox initialised with a declared data link.
### Declarative; the deployed /home/st-art/st-art/configs/tb470.setup is NOT edited.

[power]
pwr_a = (pdu, 10.36.150.14, 6)
pwr_b = (pdu, 10.36.150.14, 8)
pwr_c = (pdu, 10.36.150.14, 5)
pwr_d = (pdu, 10.36.150.14, 4)

[switch]
swi_a = /dev/u2
swi_b = /dev/u3
swi_c = /dev/u5
swi_d = /dev/u4

[baudrates]
swi_a = 115200
swi_b = 115200
swi_c = 115200
swi_d = 115200

[stack]
stk_a = swi_a, swi_c, swi_d

[configured_stackport]

[powerlink]
swi_a = pwr_a
swi_b = pwr_b
swi_c = pwr_c
swi_d = pwr_d

[boot_from_flash]
stk_a = True
swi_a = True
swi_b = True
swi_c = True
swi_d = True

[portlink]
tb-swi_c = eth1-port3.0.13
swi_a-swi_b = port1.0.10-port1.0.2, port1.0.6-port1.0.14
swi_b-swi_d = port1.0.26-port4.0.26
