### tb470 run .setup for CAMPAIGN-QUEUE-2026-10-13T0954 (T33235), written at triage 2026-10-13 by bench-runner.
### = bench-setup/tb470.setup.current (deployed tb470.setup, Oct 9) MINUS swi_e/swi_f, pwr_e/pwr_f and every
### [portlink] that touches them (session constraint: no 4050/x230; outlets 1 and 7 belong to a live campaign).
### Declarative; the deployed /home/st-art/st-art/configs/tb470.setup is NOT edited.

[power]
pwr_a = (pdu, 10.36.150.14, 6)
pwr_b = (pdu, 10.36.150.14, 8)
pwr_c = (pdu, 10.36.150.14, 5)
pwr_d = (pdu, 10.36.150.14, 4)

[switch]
swi_a = /dev/u2
swi_b = /dev/u3
swi_c = /dev/u5
swi_d = /dev/u4

[baudrates]
swi_a = 115200
swi_b = 115200
swi_c = 115200
swi_d = 115200

[stack]
stk_a = swi_a, swi_c, swi_d

[configured_stackport]

[powerlink]
swi_a = pwr_a
swi_b = pwr_b
swi_c = pwr_c
swi_d = pwr_d

[boot_from_flash]
stk_a = True
swi_a = True
swi_b = True
swi_c = True
swi_d = True

[portlink]
tb-swi_c = eth1-port3.0.13
swi_b-swi_d = port1.0.26-port4.0.26
