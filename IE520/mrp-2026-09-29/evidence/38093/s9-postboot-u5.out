1790733142.476 14:52:22 >>> show running-config
show running-config
!
service password-encryption
!
hostname IE520-stk
!
no banner motd
!
username manager privilege 15 password 8 $5$bJob5N4D$VDlAWDKf4Z/shG0P/kPIysg5qD4cc1OidC4abIHlMg7
!
!
ssh server allow-users manager
service ssh
!
no service telnet
!
service http
!
no clock timezone
!
snmp-server
!
!
!
aaa authentication enable default local
aaa authentication login default local
!
!
!
stack virtual-mac
stack virtual-chassis-id 3439
!
!
loop-protection loop-detect ldf-interval 1 fast-block
!
service mrp
service onm
no service ospf
!
mrp ring 1
 role manager
!
!
!
!
ip domain-lookup
!
!
!
no service dhcp-server
!
!
!
no ip multicast-routing
!
lldp run
!
spanning-tree mode rstp
!
no lacp global-passive-mode enable
no spanning-tree rstp enable
!
switch 1 provision ie520-28
switch 2 provision ie520-28
switch 3 provision ie520-28
switch 4 provision ie520-28
!
vlan database
 vlan 10 name data
 vlan 4000 name sx-link
 vlan 10,4000 state enable
!
interface port1.0.1
