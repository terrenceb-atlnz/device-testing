service onm
no service ospf
!
!
!
!
ip domain-lookup
!
!
!
no service dhcp-server
![K
!
!
no ip multicast-routing
!
lldp run
!
spanning-tree mode rstp
!
no lacp global-passive-mode enable
no spanning-tree rstp enable
!
switch 1 provision ie520-28
switch 2 provision ie520-28
switch 3 provision ie520-28
switch 4 provision ie520-28
!
vlan database
 vlan 10 name data
 vlan 10 state enable
!
interface port1.0.1
 switchport
 switchport mode access
!
interface port1.0.2
 switchport
 switchport mode access
 static-channel-group 2
!
interface port1.0.3-1.0.8
 switchport
 switchport mode access
!
interface port1.0.9
 switchport
 switchport mode access
 static-channel-group 2
!
interface port1.0.10-1.0.12
 switchport
 switchport mode access
!
interface port1.0.13
 switchport
 switchport mode access
 static-channel-group 3
!
interface port1.0.14-1.0.26
 switchport
 switchport mode access
!
interface port1.0.27-1.0.28
 stackport
!
interface port2.0.1-2.0.26
 switchport
 switchport mode access
!
interface port2.0.27-2.0.28
 stackport
!
interface port3.0.1
 switchport
 switchport mode access
!
interface port3.0.2
 switchport
 switchport mode access
 switchport access vlan 10
 static-channel-group 1
!
interface port3.0.3-3.0.26
 switchport
 switchport mode access
!
interface port3.0.27-3.0.28
 stackport
!
interface port4.0.1
 switchport
 switchport mode access
!
interface port4.0.2
 switchport
 switchport mode access
 switchport access vlan 10
 static-channel-group 1
!
interface port4.0.3-4.0.8
 switchport
 switchport mode access
![K
interface port4.0.9
 switchport
 switchport mode access
 static-channel-group 3
!
interface port4.0.10-4.0.26
 switchport
 switchport mode access
!
interface port4.0.27-4.0.28
 stackport
!
interface sa1
 switchport
 switchport mode access
 switchport access vlan 10
!
interface sa2-3
 switchport
 switchport mode access
!
interface vlan1
 ip address 10.38.215.10/27
 ip address 10.38.215.40/27 secondary
 ip address 10.38.215.66/27 secondary
 ipv6 enable
 ipv6 address dhcp
 ip dhcp-client vendor-identifying-class
 ip dhcp-client request vendor-identifying-specific
!
interface vlan10
 ip address 10.10.10.1/27
!
ip route 10.38.215.64/27 10.10.10.2
!
line con 0
 exec-timeout 0 0
line vty 0 7
!
end

