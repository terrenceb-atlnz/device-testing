#!/usr/bin/python
__author__ = 'Daniel Olynsma'

import re
import argparse
from sys import exit
from time import sleep, time, strftime
import traceback
import os

try:
    # noinspection PyUnresolvedReferences
    from framework.ATDrivers import ATSwitch
except ImportError:
    print('Could not find the required framework directory')
    print('Please use the following command to get it.')
    print('[git clone ssh://git.alliedtelesyn.co.nz/data/git/systest/framework.git]')
    exit()


# This is just a placeholder.  It is populated by main()
logFilename = ""


# noinspection PyPep8Naming
def main():
    # Define variables/Constants
    switchStackDutDict = {}
    oldMasterReadThreadObject = oldSwitchMasterKey = None
    lstConsoleFailoverTimes = lstMasterRejoinTimes = []
    auditInconsistencyCount = errorCount = messageCount = 0

    SCRIPT_PASS = 0
    SCRIPT_FAIL = 1
    SCRIPT_ERROR = 2
    MAX_EXCEPTION_LOG_READ_ATTEMPTS = 5
    STACK_SYNC_TIME = 120
    NEW_MASTER_READY_TIMEOUT = 10
    STACK_REFORM_TIMEOUT = 300
    STACK_SYNC_TIMEOUT = 300
    CHECK_FOR_NEW_MASTER_TIMEOUT = 20
    STOP_ON_ERROR_STRINGS = True
    STACK_MEMBERS_KEY_TEMPLATE = 'member-'
    NEW_MASTER_CHOSEN_STRINGS = ['has become the Active Master']
    NEW_MASTER_READY_STRINGS = ['Activating Hot-Standby HA processes']
    STACK_REFORM_SUCCESSFUL_STRINGS = ['Configuration update completed for port']
    STACK_FAILOVER_ERROR_STRINGS = ['Pending Master' 'Disabled Master']
    STACK_REBOOT_SUCCESSFUL_STRINGS = ['network.configured', 'Configuration update completed']
    DEFAULT_SLEEP_TIME = 120

    exitCode = SCRIPT_PASS

    # Get the start time
    scriptStartTimeStr = strftime('%Y-%m-%d_%H-%M')

    # Get commandline args and put into variables
    commandLineArgumentParser = argparse.ArgumentParser()
    commandLineArgumentParser.add_argument('-b', '--binary', dest='binarySearch', action='store_const', const=True, default=False,
                                           help='Set this flag when being used with binary search script')
    commandLineArgumentParser.add_argument('-s', '--stop', dest='stopOnMessage', action='store_const', const=True, default=False,
                                           help='Set this flag when you want the script to end if it finds the desired messages')
    commandLineArgumentParser.add_argument("failovers", help="The number of Master Failovers to do", type=int)
    commandLineArgumentParser.add_argument("logDir", help="Directory where to store logs", type=str)
    commandLineArgumentParser.add_argument('-c', '--check', dest="stringsToCheckFor", type=str, nargs=1, default="",
                                           help="list of strings that you want to check for, separated by COMMA (e.g. err,warning)")
    commandLineArgumentParser.add_argument('-v', '--verbose', dest='verbose', action='store_const', const=True, default=False,
                                           help='Set this flag when want the output of commands sent to the console')
    commandLineArgumentParser.add_argument("devices", help="Devices with consoles (ID, Console) e.g. 1,6 2,7", nargs='+')
    args = commandLineArgumentParser.parse_args()

    # If the log directory does not have slash at the end.  Add one.  Else file will not be where expected.
    if not args.logDir.endswith('/'):
        args.logDir += '/'

    # If there are specified strings split them out into list elements
    if args.stringsToCheckFor:
        stringsToCheckFor = args.stringsToCheckFor[0].split(',')
    else:
        stringsToCheckFor = ['err', 'warn']

    # Setup the log filename
    global logFilename
    logFilename = '%sreboot_master_%s.log' % (args.logDir, scriptStartTimeStr)

    # Is this TBv4
    is_TBv4 = os.path.exists('/etc/network/interfaces')

    # Initialize ATSwitch objects for each of the members with consoles
    for strCurrentDevice in args.devices:
        # Split out the device ID and the console numbers from the first item
        lstCurrentDevice = strCurrentDevice.split(',')
        stack_id = lstCurrentDevice[0]
        console = lstCurrentDevice[1]
        # Detect if is TBv4 and if so convert to format '/dev/ttyUSBx'
        try:
            if int(console) > -1 and is_TBv4:
                console = '/dev/ttyUSB%s' % console
                print('This is a TBv4.  Changed device to [%s]' % console)
        # If not int then just pass the string through
        except TypeError:
            pass
        switchStackDutDict['%s%s' % (STACK_MEMBERS_KEY_TEMPLATE, stack_id)] = ATSwitch.Switch(console, debug=args.verbose)

    # noinspection PyBroadException,PyBroadException,PyBroadException
    try:
        lstSwitchMembersKeys = sorted(switchStackDutDict.keys())
        switchMasterKey, switchMaster = set_stack_master(switchStackDutDict)
        switchMaster.name = get_host_name(switchMaster)

        # Set the per device log files before doing anything significant
        for memberKey in lstSwitchMembersKeys:
            memberObject = switchStackDutDict[memberKey]
            memberObject.logFileName = memberObject.console.logFileName = '{}.log'.format(memberKey)

        # This reboot is for when using the binary search script
        if args.binarySearch:
            switchMasterKey, switchMaster = reboot_stack_to_load_release(switchMaster, switchStackDutDict, STACK_REBOOT_SUCCESSFUL_STRINGS,
                                                                         DEFAULT_SLEEP_TIME)

        # Get and store the device info in the test log file.
        switchMaster.logFileName = logFilename
        log('---------------------------------------------------------------------')
        switchMaster.get_sys_info()
        log('---------------------------------------------------------------------')
        switchMaster.logFileName = switchMaster.console.logFileName
        numberOfStackMembersInStackAtStartOfTest = len(switchMaster.serialNum)
        log('Total number of stack members: %d' % numberOfStackMembersInStackAtStartOfTest)

        # Make sure that the console exec timeout and length have been removed.
        # Else script will hit errors during main loop
        if 'line con 0\r\n exec-timeout 0 0\r\n length 0' not in switchMaster.cmd('show run'):
            switchMaster.mode(')#')
            switchMaster.cmd('line console 0')
            switchMaster.cmd('length 0')
            switchMaster.cmd('exec-timeout 0')
            switchMaster.cmd('end')
            switchMaster.cmd('wr')
            switchMaster.cmd('exit')
            # Log back in
            switchMaster.mode('#')

        log('Clear exception log and store its baseline output')
        switchMaster.cmd('clear exception log')
        strBaselineExceptionLog = switchMaster.cmd('show exception log')

        for numberOfFailovers in range(1, (args.failovers + 1)):
            # Reset these variables back to None at the beginning of each failover
            oldMasterReadThreadObject = oldSwitchMasterKey = None
            strReadMessage = strFailoverOutput = ''
            blnErrorStringSeen = blnMasterReady = blnStackHasReformed = blnNoNewExceptions = blnStackIsReady = False

            log('---------------------------------------------------------------------')
            log('-------- Master Failover [Master Reboot] #%d' % numberOfFailovers)
            masterMemberId = switchMasterKey.split(STACK_MEMBERS_KEY_TEMPLATE)[1]
            log("Purging the asyn ports of stack")
            for memberKey in lstSwitchMembersKeys:
                response = 'test data'
                log("\tPurging the asyn of [%s]" % memberKey)
                while len(response) > 2:
                    response = switchStackDutDict[memberKey].send('', waitTime=0.2)

            oldSwitchMasterKey = switchMasterKey
            availableSlavesDict = switchStackDutDict.copy()
            del availableSlavesDict[oldSwitchMasterKey]

            monitorMemberReadThreadObject = monitorMember = None
            for memberKey in availableSlavesDict.keys():
                if monitorMember is None:
                    monitorMember = availableSlavesDict[memberKey]
                    log('Begin monitoring [%s] for:' % memberKey)
                    log('\t%s' % NEW_MASTER_CHOSEN_STRINGS)
                    monitorMemberReadThreadObject = monitorMember.read(CHECK_FOR_NEW_MASTER_TIMEOUT, NEW_MASTER_CHOSEN_STRINGS)
                    sleep(1)
                    break
            # Conduct actual failover of the current Master.
            switchMaster.cmd('clear log')
            log('Rebooting stack-member [%s]' % masterMemberId)
            switchMaster.cmd('reboot stack-member %s' % masterMemberId)
            failoverStartTime = time()
            # Start read() on the old master to capture its console output into the device console logs for possible review.
            log('Start read() on old master [%s]' % oldSwitchMasterKey)
            oldMasterReadThreadObject = switchStackDutDict[oldSwitchMasterKey].read(CHECK_FOR_NEW_MASTER_TIMEOUT + NEW_MASTER_READY_TIMEOUT +
                                                                                    STACK_REFORM_TIMEOUT, STACK_REBOOT_SUCCESSFUL_STRINGS)
            log('Waiting on read of monitored device to find string or time out')
            while not monitorMemberReadThreadObject.has_finished():
                sleep(0.5)
            log('\tRead() Thread has completed.  Checking results')

            if monitorMemberReadThreadObject.is_keyword_found():
                try:
                    match = None
                    for currentCheckString in NEW_MASTER_CHOSEN_STRINGS:
                        match = re.search(']:\sMember\s(.*?)\s(.*?)%s' % currentCheckString, monitorMember.console.buffer, re.DOTALL)
                        if match:
                            break
                    strNewMasterId = match.group(1).strip()
                    # If the above check for the active master message succeeds then just set the master to the key that contains the ID found.
                    switchMasterKey = '%s%s' % (STACK_MEMBERS_KEY_TEMPLATE, strNewMasterId)
                    log('\tString Found and points to member ID [%s]' % strNewMasterId)
                    switchMaster = switchStackDutDict[switchMasterKey]
                    log('[%s] is the new master of stack' % switchMasterKey)
                    strFailoverOutput += '%s%s' % (monitorMember.console.preReadBuf, monitorMember.console.buffer)
                except (ValueError, AttributeError):
                    write_formatted_error_messages_to_log(['ERROR: was not able to match the string correctly',
                                                           'Output from the read() Thread on monitored member', monitorMember.console.buffer])
                    raise Exception
            else:
                write_formatted_error_messages_to_log(['ERROR: Was not able to sort out the new master within the [%d] read period' %
                                                       CHECK_FOR_NEW_MASTER_TIMEOUT, 'Output from the read() Thread on monitored member',
                                                       monitorMember.console.preReadBuf, monitorMember.console.buffer])
                raise Exception

            log('Check if new Master [%s] is ready' % switchMasterKey)
            log('\tChecking last asyn port read() of [%s]' % switchMasterKey)
            for strReadMessage in NEW_MASTER_READY_STRINGS:
                # If the buffer contains any of the strings.  No need to wait round or look any further
                if switchMaster.console.buffer.find(strReadMessage) > -1:
                    log('\tString [%s] found' % strReadMessage)
                    blnMasterReady = True
                    break
            # If string not seen in the buffer then read from the console looking for string
            if not blnMasterReady:
                blnMasterReady = read_member_console_for_string(switchMasterKey, switchMaster, NEW_MASTER_READY_STRINGS, NEW_MASTER_READY_TIMEOUT)
                strFailoverOutput += '%s%s' % (switchMaster.console.preReadBuf, switchMaster.console.buffer)

            if blnMasterReady:
                log('New Master [%s] is ready.  Saw [%s]' % (switchMasterKey, strReadMessage))
                # Calculate the failover time of the console
                failoverDurationSeconds = time() - failoverStartTime
                lstConsoleFailoverTimes.append(failoverDurationSeconds)
                log('New Master [%s] took [%.3f] seconds to complete failover of console' % (switchMasterKey, failoverDurationSeconds))

                # Check if any error strings were seen during the failover up until now.
                log('Checking console output for any defined error strings')
                for currentErrorString in STACK_FAILOVER_ERROR_STRINGS:
                    if strFailoverOutput.find(currentErrorString) > -1:
                        log('\tString [%s] found' % currentErrorString)
                        blnErrorStringSeen = True
                        break
            else:
                write_formatted_error_messages_to_log(['ERROR: New Master [%s] was not found to be ready in defined time' % switchMasterKey,
                                                       switchMaster.console.buffer])
                raise Exception

            # Only continue if no errors were seen, of if they were seen and the constant to stop on errors is false
            if not (blnErrorStringSeen and STOP_ON_ERROR_STRINGS):
                log('\tNo Errors seen')
                log('Waiting until the stack has reformed before continuing')
                blnStackHasReformed = read_member_console_for_string(switchMasterKey, switchMaster, STACK_REFORM_SUCCESSFUL_STRINGS,
                                                                     STACK_REFORM_TIMEOUT)
                strFailoverOutput += '%s%s' % (switchMaster.console.preReadBuf, switchMaster.console.buffer.strip())
            else:
                if blnErrorStringSeen:
                    write_formatted_error_messages_to_log(['ERROR: Defined error strings seen during failover.', strFailoverOutput])
                    errorCount += 1
                # Only break the loop if the stop on errors has been set.
                if STOP_ON_ERROR_STRINGS:
                    log('WARNING: Script has not waited for stack to reform before exiting the main for loop')
                    raise Exception

            if blnStackHasReformed:
                stackReformTimeSeconds = time() - failoverStartTime
                lstMasterRejoinTimes.append(stackReformTimeSeconds)
                log('Old Master [%s] took [%.3f] seconds to rejoin the stack' % (oldSwitchMasterKey, stackReformTimeSeconds))
                if not oldMasterReadThreadObject.has_finished():
                    log('Stopping read() on old Master console')
                    oldMasterReadThreadObject.stop()
                switchStackDutDict[oldSwitchMasterKey].log('read output:\n%s' % switchStackDutDict[oldSwitchMasterKey].console.buffer)
                # Login to the new master
                log('Login to new Master [%s]' % switchMasterKey)
                switchMaster.mode('#')
                log('Checking exception log')
                intExceptionLogReadAttempts = 0
                while intExceptionLogReadAttempts < MAX_EXCEPTION_LOG_READ_ATTEMPTS:
                    if len(strBaselineExceptionLog) == len(switchMaster.cmd('show exception log')):
                        blnNoNewExceptions = True
                        break
                    else:
                        intExceptionLogReadAttempts += 1
                if blnNoNewExceptions:
                    log('\tNo exceptions were seen')

                    if check_logs_for_errors_warnings_or_user_messages(switchMaster, stringsToCheckFor) > 0:
                        messageCount += 1

                    if check_for_stack_audit_inconsistencies(switchMaster, numberOfStackMembersInStackAtStartOfTest) > 0:
                        auditInconsistencyCount += 1

                    if numberOfFailovers < args.failovers:
                        log('Make sure stack is [ready] before continuing')
                        log('\tWait [%d] seconds to ensure that stack is completely ready.' % STACK_SYNC_TIME)
                        sleep(STACK_SYNC_TIME)
                        log('\tCheck output of [show stack] to see if all members are [ready]')
                        intTimeOutOfReadyChecks = time() + (STACK_SYNC_TIMEOUT - STACK_SYNC_TIME)
                        while True:
                            response = switchMaster.cmd('show stack')
                            intNumberMembersReady = response.count('Ready')
                            # If the number of lines containing ready match the size of the member keys.  then this is okay
                            if (intNumberMembersReady == len(lstSwitchMembersKeys)) or \
                                    (intNumberMembersReady == numberOfStackMembersInStackAtStartOfTest):
                                log('\tStack is ready')
                                blnStackIsReady = True
                                break
                            elif time() >= intTimeOutOfReadyChecks:
                                break
                            else:
                                sleep(10)
                    # If on the last loop.  Just report the stack as ready in order not to generate an issue
                    else:
                        blnStackIsReady = True
            else:
                write_formatted_error_messages_to_log(['ERROR: Read timed out while waiting for stack to reform.', strFailoverOutput])
                raise Exception
            if not blnStackIsReady:
                write_formatted_error_messages_to_log(['ERROR: Stack did not report itself as ready after member rejoin.', strFailoverOutput])
                raise Exception
            write_formatted_error_messages_to_log(['COMPLETE CONSOLE OUTPUT', strFailoverOutput])
            log('==== Loop counters are (Log messages: %d\tErrors:%d\tInconsistencies: %d\tLoops done: %d)' %
                (messageCount, errorCount, auditInconsistencyCount, numberOfFailovers))
            # Exit loop if messages found and cli arg '-s' passed in.
            if args.stopOnMessage and messageCount > 0:
                break

    except KeyboardInterrupt:
        log('################  Saw Keyboard Interrupt  ################')
    except:
        log('################  Internal issue  ################')
        exitCode = SCRIPT_ERROR
        log(traceback.format_exc())
    else:
        log('################  Script Completed  ################')
        if errorCount == 0 and messageCount == 0:
            log('NO ISSUES SEEN')
        else:
            log('Error messages: %d\tLog messages: %d' % (errorCount, messageCount))
            exitCode = SCRIPT_FAIL
    finally:
        # Stop any read thread that was running before exiting with the correct code.
        if oldMasterReadThreadObject and oldSwitchMasterKey:
            oldMasterATSwitchObject = switchStackDutDict[oldSwitchMasterKey]
            if not oldMasterReadThreadObject.has_finished():
                log('Stopping read() on [%s] that is running in background' % oldSwitchMasterKey)
                oldMasterReadThreadObject.stop()
                oldMasterATSwitchObject.log('read output:\n%s' % oldMasterATSwitchObject.console.buffer)
        return exitCode


def get_host_name(switch):
    switch.mode('#')
    return switch.cmd('').lstrip().rstrip('#')


def log(string):
    # Uses the global variable logFilename
    log_file = open(logFilename, 'a')
    log_file.write('%s: %s\n' % (strftime('%Y-%m-%d %H:%M:%S'), string))
    log_file.close()
    print(string)


def write_formatted_error_messages_to_log(list_of_strings):
    log('%s\n--------' % '\n--------\n'.join(list_of_strings))


def get_master_id(devices_in_stack_dict, old_master_key=''):
    """
    This function searches through the devices in the stack and attempts to find the master.
    If a master is found.  It's Key value is returned
    If a master is not found then None is returned

    Required parameters:
    devicesInStackDict - Dictionary: Contains all the keys and objects of members of the stack.

    Optional keyword parameters:
    oldMasterKey - String: Key for the old Master of the stack

    returns - String: The key for the new master.  If found.  Else None, or in an extreme case the key to the old Master
    """
    available_slaves_dict = devices_in_stack_dict.copy()
    list_expected_responses_and_indicators = ['login:', 'Password:', '#', '>']
    cmd_timeout = 5
    log('Attempting to find the stack Master')
    # Remove the old master key for the list of valid choices.  Only if there was an oldMasterKey value input
    if old_master_key != '':
        log('\tThere was an old master')
        try:
            del available_slaves_dict[old_master_key]
        except KeyError:
            log('\tKey|member not found.  This should not happen')
            return None
    for member_key in sorted(available_slaves_dict.keys()):
        log('\tTesting if [%s] is the stack master' % member_key)
        get_new_master_id_member = available_slaves_dict[member_key]
        attempt = 0
        get_new_master_id_response = ''
        total_response = ''
        # noinspection PyPep8Naming
        get_new_master_id_member.preCmdBuf = ''
        while attempt < 3:
            if not get_new_master_id_response:
                get_new_master_id_response = get_new_master_id_member.send('\n', waitTime=cmd_timeout,
                                                                           strList=list_expected_responses_and_indicators)
                total_response += get_new_master_id_response
            if 'login:' in get_new_master_id_response:
                get_new_master_id_match = re.search('\r(.*?)login:', get_new_master_id_response, re.DOTALL)
                if get_new_master_id_match:
                    first_match = get_new_master_id_match.group(1)
                    # Check here to not false positive on valid host names with '-' in the middle
                    if '-' in first_match:
                        # Split the string by the '-' into an array.  Then test the last item if it is a number
                        dash_separated_hostname_list = first_match.strip().split('-')
                        dash_separated_hostname_list.reverse()
                        # Check that the string after the '-' is a digit.  If so then is a slave
                        if dash_separated_hostname_list[0].isdigit():
                            attempt = 5
                            log('\t\tNot the master: Saw [%s]' % first_match.strip('\r\n '))
                            continue
                    log('\t\tThis is the master: %s' % member_key)
                    return member_key
            elif ('#' in get_new_master_id_response) or ('>' in get_new_master_id_response):
                get_new_master_id_response = get_new_master_id_member.send('quit\n', waitTime=cmd_timeout,
                                                                           strList=list_expected_responses_and_indicators)
                total_response += get_new_master_id_response
            else:
                get_new_master_id_response = ''
            attempt += 1
            # If get here.  The output has been totally unexpected.
        if attempt == 3:
            log('[%s] Gave unexpected responses\n%s' % (member_key, total_response))
    # If the function makes it this far, there is a problem.  So return the original masterKey
    log('getNewMasterId() got into a weird state')
    if old_master_key != '':
        log('\tReturning old MasterKey [%s]' % old_master_key)
        return old_master_key
    else:
        return None


def read_member_console_for_string(member_key, member_object, list_of_read_strings, read_time_out):
    log("\tReading [%s] asyn for [%d] or until see one of the following:" % (member_key, read_time_out))
    log("\t%s" % list_of_read_strings)
    # Clear the preReadBuf
    # noinspection PyPep8Naming
    member_object.console.preReadBuf = ''
    bln_string_seen_in_pre_read_buffer = False
    read_thread_object = member_object.read(read_time_out, list_of_read_strings)
    # Check the preRead buffer to see if was in console waiting between last read and now.
    for current_Read_String in list_of_read_strings:
        if current_Read_String in member_object.console.preReadBuf:
            log('\tString seen in preReadBuf')
            bln_string_seen_in_pre_read_buffer = True
            break
    if bln_string_seen_in_pre_read_buffer:
        read_thread_object.stop()
    else:
        # Put this sleep in here because of false positives on the following threading event.
        sleep(1)
        # Wait for the read() thread to complete.
        try:
            while not read_thread_object.has_finished():
                sleep(0.5)
        except KeyboardInterrupt:
            log('\tStopping read() on [%s] due to keyboard interrupt' % member_key)
            read_thread_object.stop()
            member_object.log('read output:\n%s' % member_object.console.buffer)
            raise KeyboardInterrupt
    log('\tRead() Thread has completed.  Checking results')
    # If the a whole string of any of the match strings were seen in the actual read.  Return
    if read_thread_object.is_keyword_found():
        return True
    # If did not see any of the whole strings in the read.  Combine the preReadBuf and the read buffer to look for result.
    output_from_read = member_object.console.preReadBuf + member_object.console.buffer
    for current_Read_String in list_of_read_strings:
        if current_Read_String in output_from_read:
            return True
    return False


def set_stack_master(devices_in_stack_dict):
    switch_master_key = get_master_id(devices_in_stack_dict)
    if switch_master_key is not None:
        stack_master_switch_object = devices_in_stack_dict[switch_master_key]
        log('[%s] is the master of stack' % switch_master_key)
        return switch_master_key, stack_master_switch_object
    else:
        log('NO MASTER WAS FOUND.  TEST ABORTED')
        raise Exception


def check_logs_for_errors_warnings_or_user_messages(switch_object, log_strings_to_check_for):
    current_message_count = 0
    for current_log in ('show log', 'show log permanent'):
        for currentSearchString in log_strings_to_check_for:
            log_command = '%s | include "%s"' % (current_log, currentSearchString)
            cmd_response = switch_object.cmd(log_command)
            if (cmd_response.count(currentSearchString) - cmd_response.count(log_command)) >= 1:
                write_formatted_error_messages_to_log(['[%s] contained [%s] messages' % (current_log, currentSearchString), cmd_response])
                current_message_count += 1
            else:
                log('[%s] contained NO [%s] messages' % (current_log, currentSearchString))
    return current_message_count


def check_for_stack_audit_inconsistencies(switch_object, number_of_stack_members):
    current_audit_inconsistency_count = 0
    sleep_time = 10
    max_attempts = 3
    found_audit_inconsistencies = False
    for consistency_cmd in ('remote-diff all show interface brief', 'remote-diff all show hsl infrastructure'):
        attempt = 1
        consistency_cmd_response = ''
        log('Checking [%s] for inconsistencies' % consistency_cmd)
        while attempt <= max_attempts:
            found_audit_inconsistencies = False
            consistency_cmd_response = switch_object.cmd(consistency_cmd)
            if consistency_cmd_response.count('Results are identical') != (number_of_stack_members - 1):
                # Only do these checks if is the 'show hsl infrastructure' command
                if 'show hsl infrastructure' in consistency_cmd:
                    for currentLine in consistency_cmd_response.splitlines():
                        if currentLine.startswith('+') and not currentLine.startswith('+Unit'):
                            found_audit_inconsistencies = True
                            break
                else:
                    found_audit_inconsistencies = True
            else:
                if found_audit_inconsistencies:
                    log('\tInconsistencies resolved')
                    found_audit_inconsistencies = False
            if (attempt < max_attempts) and found_audit_inconsistencies:
                log("\tSleep for [%d] seconds to see if state changes." % sleep_time)
                sleep(sleep_time)
                attempt += 1
            else:
                attempt = max_attempts + 1
        # If the remote-diff command found actual inconsistencies then up the loop counter
        if found_audit_inconsistencies:
            list_of_strings_for_error_log = ['\tINCONSISTENCIES SEEN', consistency_cmd_response]
            # Only do something if able to get to the start-shell and only do it once
            if current_audit_inconsistency_count == 0:
                list_of_strings_for_error_log.append(get_contents_of_file_and_any_rotated_versions(switch_object, '/var/log/trace'))
            write_formatted_error_messages_to_log(list_of_strings_for_error_log)
            current_audit_inconsistency_count += 1
        else:
            log('\tNO inconsistencies seen')
    return current_audit_inconsistency_count


def reboot_stack_to_load_release(switch_object, stack_members_dict, stack_reboot_successful_strings, sleep_time):
    reboot_was_good = False
    log('Doing reboot to load release set by binary search script')
    output_from_reboot = switch_object.reboot()
    for current_list_item in stack_reboot_successful_strings:
        if output_from_reboot.find(current_list_item) > -1:
            reboot_was_good = True
            log('Reboot successful.  Saw [%s] string in reboot output' % current_list_item)
            break
    if not reboot_was_good:
        log('################  INITIAL/SETUP REBOOT FAILED  ################\n-----\n%s\n-----' % output_from_reboot)
        raise Exception
    else:
        # Purge the consoles of all the members.
        log("Purging the asyn ports of stack")
        for memberKey in sorted(stack_members_dict.keys()):
            log("\tPurging the asyn of [%s]" % memberKey)
            stack_members_dict[memberKey].send('', 2)
        # Check that the master member has not changed after the reboot.
        stack_master_key, stack_master_object = set_stack_master(stack_members_dict)
        log('Sleep for %d seconds' % sleep_time)
        sleep(sleep_time)
        return stack_master_key, stack_master_object


def get_contents_of_file_and_any_rotated_versions(switch_object, filename_interested_in):
    """
    Get the directory listing of trace* files.
    Cat each present file
    [root@x610-6stk /flash]# ls -lrt /var/log/trace*
    -rw-r--r--    1 root     root         10408 Apr  7 14:18 /var/log/trace.1
    -rw-r--r--    1 root     root           955 Apr  7 14:18 /var/log/trace
    [root@x610-6stk /flash]
    """
    complete_log_information = ''
    if switch_object.mode(']#'):
        cmd_response_line_list = switch_object.cmd('ls -lrt --color=never %s*' % filename_interested_in).splitlines()[1:-1]
        # split out the relevant column from each line and then work through the list
        for current_line in cmd_response_line_list:
            current_log_filename = current_line.split()[8].strip()
            complete_log_information += switch_object.cmd('cat %s' % current_log_filename, maxWait=15)
        switch_object.mode('#')
    else:
        complete_log_information = 'NO INFO: Was not able to get to start-shell'
    return complete_log_information


if __name__ == "__main__":
    # the return value from main is used as the argument to
    # sys.exit, which you can test for in the shell.
    # program exit codes are usually 0 for ok, and non-zero for something
    # going wrong.
    exit(main())