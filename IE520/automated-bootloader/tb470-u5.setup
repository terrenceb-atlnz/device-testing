### ============================================================================
### !! SUPERSEDED AS A DESCRIPTION OF THE BENCH -- 2026-09-01.
###    This file is NOT the tb470 bench's state and must not be read as it. It is a
###    purpose-built, single-DUT rig for the 5700 bootloader campaign of 2026-08-11,
###    when the two IE520s were STANDALONE and each was bound as swi_a in its own run.
###    They have been ONE STACK since 2026-08-18, so this file's device roles, hub
###    links and portlinks no longer describe anything that is cabled.
###    Current bench state: ~/claude/IE520-testing/bench-setup/bench-state.md
###    (from which /home/st-art/st-art/configs/tb470.setup is generated).
###    Kept because it is the record of how that campaign was rigged, and because its
###    portlink notes are the independent 2026-08-11 corroboration of which LAG leg
###    lands on which AR4050S port -- cited in the bench-state record.
### ============================================================================
### tb470 - IE520 on /dev/u5, bound as role swi_a.  Run B (suite 2003).
### Management port cabled to tb470 eth2.  PDU socket labelled "E".
###
### The scripts bind setup.init_swi('swi_a'), so the SECOND DUT is also declared as
### swi_a - in its own setup file and its own run directory.  swi_b is not used.
###
### See tb470-u4.setup for the full reasoning behind the differences from the tb504
### default.setup (115200 baud, no tb-swi_a data-plane link).  The short version for
### this file: /dev/u5 -> ttyNumber 5 -> ipDevice = eth2.get_ipv4_addr(2 + 5), so the
### DUT boots at 10.38.215.39 with the TFTP server at eth2's own 10.38.215.33.
###
### eth2's subnet 10.38.215.32/27 has NO dhcpd pool and dhcpd is not bound to it
### (only eth1 .2-.10 and eth3 .68-.94), so this segment is clean - unlike the u4
### run's eth3.  Do not add a subnet declaration for it.

[power]
### Front-panel "E" = outlet 5.  See tb470-u4.setup for the A-H = 1-8 mapping and
### why the faceplate letter cannot be used directly.
pwr_a = (pdu, 10.36.150.14, 5)

[switch]
swi_a = /dev/u5

[baudrates]
swi_a = 115200

[powerlink]
swi_a = pwr_a

### Device TFTP boots over its management port ###
[hub]
hub_a = tb, swi_a

[portlink]
### BOOTLOADER TFTP boot link: tb470 eth2 (10.38.215.33/27) <-> the IE520's USB
### ethernet dongle, which the bootloader calls eth0.  DUT boots at 10.38.215.39,
### TFTP server is eth2's own 10.38.215.33.
hub_a-tb = eth2
hub_a-swi_a = eth0

### POST-BOOTUP CLI file-transfer link -- populates flash with mainrelease.rel /
### backuprelease.rel.  See tb470-u4.setup for the full reasoning; the path here is
###     swi_b port1.0.1 -> AR4050S (swi_c) port1.0.4 -> vlan1 -> tb470 eth1
### and this DUT is /dev/u5, so ipOffset = 5 + 2 and it addresses 10.38.215.7.
### Verified 2026-08-11: AR4050S port1.0.4 reads "running" with this cable in place.
###
### !! Do NOT re-route this through swi_a -- each run's default.cfg shuts every port
### !! on its own DUT, so the two IE520s must not depend on one another.
tb-swi_a = eth1-port1.0.1
