[power]
pwr_a = (pdu, 10.36.230.42, 2)

[switch]
swi_a = /dev/ttyUSB0

[baudrates]
swi_a = 9600

[powerlink]
swi_a = pwr_a

### Device TFTP boots over temporary eth port ###
[hub]
hub_a = tb, swi_a

[portlink]
### Post-bootup link between tb and swi_a:
###    e.g.:
###    tb-swi_a = eth2-port1.0.1
tb-swi_a = eth1-port1.0.1

### TFTP boot link between tb and swi_a:
###    e.g.:
###    hub_a-tb = eth3
###    hub_a-swi_a = eth0
hub_a-tb = eth2
hub_a-swi_a = eth0

